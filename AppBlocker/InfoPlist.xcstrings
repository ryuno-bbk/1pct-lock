      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1% uses the camera to take a photo for your post's background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿の背景写真をその場で撮影するため、カメラを使用します。"
          }
