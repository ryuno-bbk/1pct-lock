    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1% uses your location to lock apps when you arrive at places you register, like a café or your office. Location is used at all times so locks work in the background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特定の場所に入った時にアプリをロックするため、位置情報を常に使用します。カフェや職場など、集中したい場所を登録できます。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1% uses your location to lock apps when you enter a place you've registered."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特定の場所に入った時にアプリをロックするため、位置情報を使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1% needs permission to save quote images you like to your photo library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1% で気に入った名言の画像をカメラロールに保存するため、写真への追加権限が必要です。"
          }
        }
      }
